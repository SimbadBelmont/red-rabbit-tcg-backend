# --- Servidor ---
PORT=5000
MONGO_URI=mongodb://usuario:password@host:27017/redrabbit?authSource=admin
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-secreta

# --- Correo (Nodemailer / SMTP) ---
# Resend:  SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=re_tu_api_key
# Brevo:   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=(login SMTP)  SMTP_PASS=(SMTP key)
# Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=tu@gmail.com  SMTP_PASS=(contraseña de aplicación)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_tu_api_key
# Remitente que ven los clientes (debe ser de tu dominio verificado). Si se omite, usa SMTP_USER.
SMTP_FROM=pedidos@tudominio.com
CORREO_TIENDA=tienda@ejemplo.com
NOMBRE_TIENDA=Red Rabbit TCG Store

# --- Scryfall (arte de cartas de Magic) ---
SCRYFALL_USER_AGENT=RedRabbitTCG/1.0 (tienda@ejemplo.com)

# --- Pedidos ---
DIAS_APARTADO=3
